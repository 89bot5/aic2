[Unit]
Description=aic2 chat
After=network-online.target
Wants=network-online.target

[Service]
# APP_DIR is replaced with the app's folder during setup (see README).
User=chatapp
Group=chatapp
WorkingDirectory=APP_DIR
ExecStart=/usr/bin/node APP_DIR/server.js
Restart=on-failure
RestartSec=3

# Chats, the password and the API key live here (created automatically, owned by chatapp).
StateDirectory=aic2
Environment=DATA_DIR=/var/lib/aic2
Environment=HOST=127.0.0.1
Environment=PORT=3000
# Uncomment to serve under a subpath such as https://example.com/aic/
#Environment=BASE_PATH=/aic

# Hardening: the app only needs to read its own files, write its data folder and use the network.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true

[Install]
WantedBy=multi-user.target
