# Copy to /etc/chatapp.env and fill in. Keep it chmod 600.

# Password for the login page
APP_PASSWORD=change-me

# Random string for signing login cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Postgres connection
DATABASE_URL=postgresql://chatapp:db-password-here@localhost:5432/chatapp

# Model API (any OpenAI-compatible endpoint)
API_BASE_URL=https://api.abliteration.ai/v1
API_KEY=
MODEL=abliterated-model

# Optional: a default system prompt for chats that don't have their own
# (set per chat with the cog icon in the sidebar)
# SYSTEM_PROMPT=You are a helpful assistant.

# URL subpath the app is served under (leave empty to serve at the site root)
BASE_PATH=/aic

# Where the app listens (nginx proxies to this)
HOST=127.0.0.1
PORT=3000
